# AI analyst: set ONE of these keys. With neither, picks use offline rule-based analysis.
# OpenAI key (https://platform.openai.com). Model defaults to gpt-5.5; override with OPENAI_MODEL.
OPENAI_API_KEY=
OPENAI_MODEL=
# Claude key (https://platform.claude.com). Model defaults to claude-opus-5-5; override with CLAUDE_MODEL.
ANTHROPIC_API_KEY=
# If both keys are set, OpenAI is used unless you set AI_PROVIDER=anthropic.
AI_PROVIDER=
# The Odds API key (https://the-odds-api.com). Without it, a demo odds feed is used.
ODDS_API_KEY=
# Odds API regions to pull; "eu" includes Pinnacle, the sharpest reference book.
ODDS_REGIONS=us,us2,eu
# Optional shared secret; set the same value as EdgeAPIToken in the iOS Info.plist.
APP_TOKEN=
# How long a researched board is served before refreshing, and how many bets the analyst researches per sport.
PICKS_TTL_MINUTES=20
MAX_ANALYZED_PER_SPORT=6
PORT=8787
